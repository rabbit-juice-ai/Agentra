{
  "name": "@agentra/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@agentra/protocol": "workspace:*",
    "@agentra/runtime-sdk": "workspace:*",
    "@agentra/shared": "workspace:*",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentra/daemon": "workspace:*",
    "@agentra/runtime-cli": "workspace:*",
    "@types/ws": "8.18.2"
  }
}
